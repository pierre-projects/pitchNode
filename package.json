{
  "name": "pitchnode",
  "displayName": "Pitchnode",
  "version": "0.0.1",
  "description": "Chromatic tuner for guitar, bass and more. Live note, Hz and cents with a flat/sharp meter. Audio never leaves your device.",
  "author": "pierres.dev",
  "scripts": {
    "dev": "plasmo dev",
    "build": "plasmo build",
    "package": "plasmo package",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "lucide-react": "^1.8.0",
    "plasmo": "0.90.5",
    "react": "18.2.0",
    "react-dom": "18.2.0"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "4.1.1",
    "@types/chrome": "^0.0.258",
    "@types/node": "20.11.5",
    "@types/react": "18.2.48",
    "@types/react-dom": "18.2.18",
    "autoprefixer": "^10.5.0",
    "prettier": "3.2.4",
    "tailwindcss": "^3.4.19",
    "typescript": "5.3.3",
    "vitest": "^4.1.11"
  },
  "manifest": {
    "action": {
      "default_popup": "popup.html"
    },
    "permissions": [
      "sidePanel",
      "microphone"
    ],
    "side_panel": {
      "default_path": "sidepanel.html"
    }
  }
}
